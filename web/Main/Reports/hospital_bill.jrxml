<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hospital_bill" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0006df70-4d89-4da9-9e3f-6086a39bb781">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Arogya_main"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="bill_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[

select isnull(pb.item_code,'')as item_code,
isnull(item_name,'')as item_name,
isnull(qty,'')as qty,
isnull(unit,'')as unit,
isnull(bill_id,'')as bill_id,
isnull(mobile_no,'')as mobile_number,
isnull(bill_to,'')as bill_to,
isnull(address,'')as addess,
isnull(tot_bill_amt,0)as tot_bill,
isnull(extra,0)as extra,
isnull(final_amt,0)as final,
isnull(item_sale_rate,'')as item_sale,
isnull(item_total,'')as item_total,
isnull((select isnull(hospital_name,'')as hospital_name from mst_hospital),'')as hospital_name
from pharmacy_bills pb left join final_bill_total fbt on pb.bill_id=fbt.bill_code
left join phr_items pi on pb.item_code=pi.item_code 
left join phr_item_rates phr on pb.item_code=phr.item_code

where pb.bill_id=$P{bill_id}]]>
	</queryString>
	<field name="item_code" class="java.lang.String"/>
	<field name="item_name" class="java.lang.String"/>
	<field name="qty" class="java.lang.String"/>
	<field name="unit" class="java.lang.String"/>
