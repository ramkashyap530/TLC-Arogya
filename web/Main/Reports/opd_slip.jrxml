<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="opd_slip" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7db55ac3-6793-48a9-bb1e-54181cc55a78">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Arogya_main"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="patient_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select isnull(opd_id,'')as opd_id,
isnull(mo.rwid,'')as opd_no,isnull(patient_name,'')as patient_name,
isnull(mo.address,'') as address,isnull(age,'')as age,isnull(format(mo.create_date,'dd/MM/yyyy'),'')as c_date,
isnull(mo.mobile_number,'')as mobile_number,isnull(const_cahrge,0)as const_charge,isnull(Real_Name,'')as real_name,
isnull(concat(doc_name_first,'',doc_name_last),'')as doc_name,
isnull(hospital_name,'')as hospital_name,
isnull(mh.address,'')as hos_address,
isnull(dbo.GET_NUM2WORD(const_cahrge),'')as in_word
from mst_opd mo

left join mst_doctor md on mo.doc_code=md.Doc_code left join login_info lf on mo.created_by=lf.user_id
left join mst_hospital mh on mo.hospital_code=mh.hospital_code
where mo.opd_id=$P{patient_id}
]]>
	</queryString>
	<field name="opd_id" class="java.lang.String"/>
	<field name="opd_no" class="java.lang.String"/>
	<field name="patient_name" class="java.lang.String"/>
	<field name="address" class="java.lang.String"/>
	<field name="age" class="java.lang.String"/>
