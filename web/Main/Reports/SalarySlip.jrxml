	<subDataset name="Dataset1" uuid="d302e59a-1da7-4285-ae8f-274040137a3e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ERP_SCHOOL"/>
		<queryString language="SQL">
			<![CDATA[select rwid,class_name from school_class]]>
		</queryString>
	</subDataset>
	<parameter name="slip_no" class="java.lang.String">
		<defaultValueExpression><![CDATA["SFSLR-2122-07"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[
select isnull(emp_id,'')as emp_id,
isnull(base_salary,'')as base_salary,
isnull(salary_paid,0)as salary_paid,
isnull(ssp.month_name,'')as month_name,
isnull(year_number,'')as month_year,
isnull(name,'')as name,
isnull(department_name,'')as deparatment_name,
isnull(postion,'')as position,isnull(format(date_of_joining,'dd/MM/yyyy'),'')as date_of_joining,
isnull(mobile_number,'')as mobile_number,isnull(adhar_card,'')as adhar_card,
isnull(gender,'')as gender,isnull(age,'')as age,
isnull(bank_name,'')as bank_name,isnull(account_number,'')as account_number,
isnull(hospital_name,'')as hospital_name,
isnull(address,'')as address,isnull(slip_no,'')as slip_number,
isnull(paid_date,'')as paid_date,
isnull(amount,'')as ad_amount,
isnull(0,'')as zero

from staff_salary_payment ssp 
left join hospital_staff hs on ssp.emp_id=hs.staff_id
left join hosiptal_department hd on hs.Depertament=hd.department_code
left join staff_bank_detalils sbd on ssp.emp_id=sbd.staff_id 
left join mst_hospital mh on hs.hospital_code=mh.hospital_code
left join salary_advance sa on ssp.emp_id=sa.staff_id
where slip_no=$P{slip_no}
]]>
	</queryString>
