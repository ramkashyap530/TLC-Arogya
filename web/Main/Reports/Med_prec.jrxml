	<parameter name="OPD_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[
select
   isnull(mo.opd_id,'')as opd_id,
isnull(age,'')as age, isnull(hospital_registration,'')as hospital_registration,
isnull(specialist,'')as specialist,isnull(degree,'')as degree,
isnull(mdc.mobile_number,'')as doc_mob_num,
isnull(medicine_name,'')as medicine_name,isnull(dosage,'')as dosage,
isnull (Additional_comments,'')as Additional_comments,isnull(CONCAT(doc_name_first,'',doc_name_last),'')as doc_name,
 isnull(test_name,'')as Test_name,
isnull(comments,'')as comments,
isnull(hospital_name,'')as hospital_name,
isnull(mh.address,'')as hospital_address,
isnull(diagonsis,'')as diagonsis,
isnull(patient_name,'')as patient_name,
isnull(next_visit_date,'')as next_visit_date,
isnull(mh.number_1,'')hospital_number_1,
isnull(mh.number_1,'')hospital_number_2
from mst_medicine md
inner join mst_opd mo on mo.opd_id=md.opd_id
inner join mst_test_prec mtp on md.opd_id=mtp.opd_id
inner join preciption_id pd on md.opd_id=pd.opd_id
inner join mst_hospital mh on mh.hospital_code=md.hospital_code
inner join mst_doctor mdc on mdc.Doc_code=mo.doc_code
where md.opd_id=$P{OPD_ID}]]>
	</queryString>
