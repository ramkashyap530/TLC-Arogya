	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Arogya_main"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="patient_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  isnull(pd.patient_id,'')as patient_id,
isnull(condition_on_discharge,'')as condition,
isnull(vital_on_discharge,'')as vital,
isnull(history_of_present_illeness,'')as history,
isnull(format(created_date,'dd/MM/yyyy'),'')as dischage_date,
isnull(patient_name,'')as patient_name,
isnull(age,'')as age,
isnull(gender,'')as gender,
isnull(mip.address,'')as address,
isnull(format(admision_date,'dd/MM/yyyy'),'')as admission_date,
isnull(father_name,'')as father_name,
isnull(hospital_name,'')as hospital_name,
isnull(mh.address,'')as hos_address ,
isnull(adhar,'')as adhar,
isnull(ipd_no,'')as ipd,
isnull(refer_doctor,'Self')as refer

from patient_discharge pd left join mst_ipd_patient mip on pd.patient_id=mip.patient_id
left join mst_hospital mh on mh.hospital_code=mip.hospital_code
where mip.patient_id=$P{patient_id}
]]>
	</queryString>
	<field name="patient_id" class="java.lang.String"/>
