<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Provisional_bill" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3bbdf55a-55ff-4986-86be-908459901e55">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Agrogya"/>
	<parameter name="patient_id" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select ISNULL(pws.Bill_no,'')as bill_no,isnull(pws.patient_id,'')as patient_id,isnull(category_name,'')as category_name,
isnull(charge_name,'')as charge_name,isnull(rate,'')as rate,isnull(qty,'')as qty,isnull(total_amount,'')as total_amt,
isnull(pws.create_date,'')as create_date,isnull(Bill_gross_amount,'')as Bill_gross_amount,isnull(bill_discount,'')as bill_discount,
isnull(Bill_final_paid,'')as bill_final_paid,ISNULL(Bill_status,'')as bill_status,
isnull(admision_date,'')as admission_date,isnull(room_bed_id,'')as room_id,isnull(mip.patient_name,'')as patient_name,
isnull(age,'')as age,isnull(gender,'')as gender,isnull(mip.address,'')as patient_address,
isnull(father_name,'')as father_name,isnull(UHID,'')as UHID,isnull(ipd_no,'')as ipd_no,
isnull(discharge_date,'')as discharge_date,
isnull(Relative_name,'')as relative_name,isnull(Relation,'')as relation,isnull(Relative_number,'')as relative_number,
isnull(relative_address,'')as relative_address,
isnull(hospital_name,'')as hospital_name,isnull(mh.address,'')as hos_address,
isnull(mh.hospital_registration,'')as hos_regis,
isnull(mh.number_1,'')as number_1,
isnull(mh.number_2,'')as number_2,
isnull(CONCAT(doc_name_first,' ',doc_name_last),'')as doc_name
from Patient_waise_bill_saving  pws inner join ipd_final_bill ifb on pws.Bill_no=ifb.Bill_no
inner join mst_ipd_patient mip on mip.patient_id=pws.patient_id
inner join patient_relatives pr on pr.patient_id=mip.patient_id
inner join mst_hospital mh on mh.hospital_code=mip.hospital_code
inner join mst_doctor md on md.Doc_code=mip.doctor_id
where pws.patient_id=$P{patient_id}
]]>
	</queryString>
