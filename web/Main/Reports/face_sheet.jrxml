	<parameter name="patient_id" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[
select isnull(mip.patient_id,'')as patient_id,
isnull(patient_name,'')as patient_name,
isnull(father_name,'')as father_name,
isnull(mip.address,'')as address,
isnull(phone,'')as phone,
isnull(format(admision_date,'dd/MM/yyyy'),'')as admission_date,
isnull(refer_doctor,'')as refer_doc,
isnull(concat(doc_name_first,'',doc_name_last),'')as doctor,
isnull(bed_number,'')as bed_number,isnull(Room_number_name,'')as room_name,
isnull(hospital_name,'')as hospital_name,isnull(mh.address,'')as address_hos,
isnull(ipd_no,'')as ipd_no,isnull(UHID,'')as UHID,isnull(age,'')as age,isnull(gender,'')as gender,isnull(FORMAT(discharge_date,'dd/MM/yy'),'')as discharge_date
from mst_ipd_patient  mip left join mst_doctor md on md.Doc_code=mip.doctor_id
LEFT join room_beds mb on mb.room_bed_id=mip.room_bed_id left join mst_rooms mr on mr.Room_id=mb.room_id
left join mst_hospital mh on mh.hospital_code=mip.hospital_code
   where mip.patient_id=$P{patient_id}]]>
	</queryString>
