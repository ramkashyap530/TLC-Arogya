	<subDataset name="tableDataset" uuid="f89e18ae-1ba1-4906-84df-8a7b6a41d045">
		<queryString>
			<![CDATA[]]>
		</queryString>
	</subDataset>
	<parameter name="Patient_id" class="java.lang.String"/>
	<parameter name="Voc_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[
  select isnull(ipp.patient_id,'')as patient_name,
  isnull(amount,'')as amount,
  isnull(dbo.GET_NUM2WORD(amount),'')as in_word,
  isnull(format(payment_date,'dd/MM/yy'),'')as payment_date,
  isnull(taken_by,'')as taken_by,
  isnull(voucher_id,'')as voucher_id,
  isnull(remark,'')as remark,
  isnull(paytype,'')as paytype,
  isnull(cheque_number,'')as cheque_number,
  isnull(card_number,'')as card_number,
  isnull(upi_type,'')as upi_type,
  isnull(transcation_id,'')as transcation_id,
  isnull(mip.UHID,'')as uhid,
  isnull(mip.age,'')as age,
  isnull(mip.gender,'')as gender,
  isnull(mh.hospital_name,'')as hospital_name,
  isnull(mh.address,'')as hos_address,
  isnull(mh.hospital_gst,'')gst,
  isnull(mh.hospital_registration,'')as reg,
  isnull(mh.number_1,'')as number_1,
  isnull(mh.number_2,'')as number_2,
  isnull(mh.number_3,'')as number_2,
  isnull(lf.Real_Name,'')as real_name,
  isnull(mip.ipd_no,'')as ipd_No,
  isnull(recieved_from,'')as recieved_from,
  isnull(concat(md.doc_name_first,' ', md.doc_name_last),'')as doc_name
  from ipd_patient_payment ipp inner join mst_ipd_patient mip on mip.patient_id=ipp.patient_id 
  inner join mst_hospital mh on mip.hospital_code=mh.hospital_code
  inner join mst_doctor md on mip.doctor_id=md.Doc_code
  inner join login_info lf on lf.user_id=ipp.taken_by


  where ipp.patient_id=$P{Patient_id} 
  and ipp.voucher_id=$P{Voc_id}  



 ]]>
	</queryString>
